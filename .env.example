# Sensor Tower
SENSOR_TOWER_AUTH_TOKEN=
SENSOR_TOWER_BASE_URL=https://api.sensortower.com

# Socialdata
SOCIALDATA_BASE_URL=https://socialdata.garena.vn
SOCIALDATA_USESSION=
SOCIALDATA_GOOGLE_ACCESS_TOKEN=
SOCIALDATA_GOOGLE_SERVICE_ACCOUNT_FILE=
SOCIALDATA_TIMEOUT_SECONDS=60
SOCIALDATA_APP_SLUG=srcvn

# OpenAI-compatible Compass Gateway
OPENAI_API_KEY=
OPENAI_BASE_URL=https://compass.llm.shopee.io/compass-api/v1
OPENAI_PROVIDER=OpenAI
OPENAI_MODEL=gpt-5.4-nano
# Legacy FB-only merge command
OPENAI_FB_MERGE_MODEL=gpt-5.4-mini
# Final cross-source unified merge command
OPENAI_UNIFIED_EVENT_MERGE_MODEL=gpt-5.4
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_RETRIES=3

# Optional local overrides
# SENSOR_TOWER_RAW_DIR=data_ingest/sensortower/raw

# Event tracked-games workspace SSO. Local development can use
# ADMIN_COOKIE_SECURE=0, while production must keep it enabled.
ADMIN_UI_ENABLED=0
ADMIN_AUTH_MODE=portal_with_password_fallback
ADMIN_PASSWORD=
PORTAL_GRANT_CONSUME_URL=
EVENT_WORKSPACE_SERVICE_TOKEN=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=1800
ADMIN_ROUTE_PREFIX=/workspaces/tracked-games/events
ADMIN_COOKIE_SECURE=1
